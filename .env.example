# Application database traffic should use the pooled URL; Alembic migrations should use the direct URL.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Managed Neon Auth base URL from the Neon Console.
NEON_AUTH_BASE_URL=
# Optional override; otherwise derived from NEON_AUTH_BASE_URL.
NEON_AUTH_JWKS_URL=

# Bifrost's OpenAI-compatible API. Configure a provider in the gateway itself.
BIFROST_BASE_URL=http://localhost:8080/openai
BIFROST_MODEL=openai/gpt-4o-mini
# Models users can switch between in the UI ("provider/model"; each provider needs a key in Bifrost).
# Free options: groq/* and gemini/* (free-tier keys), openrouter/*:free, ollama/* (local, no key).
BIFROST_MODELS=["openai/gpt-4o-mini","openai/gpt-4o","anthropic/claude-haiku-5-5","anthropic/claude-sonnet-5-5","anthropic/claude-opus-5-5","groq/llama-3.3-70b-versatile","groq/llama-3.1-8b-instant","gemini/gemini-2.5-flash","openrouter/meta-llama/llama-3.3-70b-instruct:free","ollama/llama3.2"]
# Optional: Bifrost tries these in order if the selected model fails, e.g. ["anthropic/claude-haiku-5-5"]
BIFROST_FALLBACK_MODELS=[]
BIFROST_VIRTUAL_KEY=

# Frontend origins allowed by the local FastAPI development server.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
